# Public site URL (no trailing slash). Used for canonical URLs, sitemap, schema and OG images.
NEXT_PUBLIC_SITE_URL=https://fixghl.com

# GoHighLevel calendar embed URL (Calendars > Share > Embed, the iframe src). [[TODO: GHL calendar embed URL]]
NEXT_PUBLIC_GHL_CALENDAR_URL=

# Server-only: GHL inbound webhook (Automation > Workflow > Inbound Webhook trigger) that receives the fallback form. [[TODO]]
GHL_FORM_WEBHOOK_URL=

# GoHighLevel affiliate link for /try-ghl. [[TODO: affiliate URL]]
NEXT_PUBLIC_GHL_AFFILIATE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable GA and the consent banner.
NEXT_PUBLIC_GA_ID=

# Search engine verification tokens (content values only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow key. Must match the file public/<key>.txt.
INDEXNOW_KEY=03ce8abe2fc275f9b08416cd125d578d

# Show the testimonials section only once real, approved testimonials exist.
NEXT_PUBLIC_SHOW_TESTIMONIALS=false
